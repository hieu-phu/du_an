{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "concurrently -n \"VITE,SERVER,QUEUE\" -c \"blue,green,magenta\" \"vite\" \"php artisan serve\" \"composer run queue:work\"",
        "queue:work": "composer run queue:work",
        "queue:failed": "composer run queue:failed",
        "queue:retry": "composer run queue:retry",
        "queue:restart": "composer run queue:restart"
    },
    "devDependencies": {
        "@laravel/echo-vue": "^2.2.6",
        "@tailwindcss/postcss": "^4.0.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "rollup-plugin-visualizer": "^6.0.5",
        "tailwindcss": "^4.0.0",
        "terser": "^5.46.0",
        "vite": "^7.0.7",
        "vite-plugin-compression": "^0.5.1"
    },
    "dependencies": {
        "@inertiajs/vue3": "^2.2.19",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.16",
        "@vitejs/plugin-vue": "^6.0.2",
        "@vueform/multiselect": "^2.6.11",
        "@vuepic/vue-datepicker": "^12.1.0",
        "axios": "^1.13.2",
        "date-fns": "^4.1.0",
        "flatpickr": "^4.6.13",
        "laravel-echo": "^2.2.7",
        "lodash": "^4.17.21",
        "nprogress": "^0.2.0",
        "primevue": "^4.5.3",
        "pusher-js": "^8.4.0",
        "sweetalert2": "^11.26.24",
        "vue": "^3.5.25",
        "vue-flatpickr-component": "^11.0.5",
        "vue3-toastify": "^0.2.8",
        "ziggy-js": "^2.6.0"
    }
}
